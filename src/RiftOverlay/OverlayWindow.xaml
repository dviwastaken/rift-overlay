<Window x:Class="RiftOverlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RiftOverlay.ViewModels"
        Title="RiftOverlay"
        Opacity="{Binding Settings.Opacity}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:AllTrueToVisibilityConverter x:Key="AllTrue" />
        <vm:NotBoolToVisibilityConverter x:Key="NotBoolToVis" />
        <vm:FractionConverter x:Key="Fraction" />

        <!-- Yari saydam: overlay oyunun ustunde duruyor. Metin tonlari, kenarlik ve vurgu
             renkleri Theme.xaml icinde, client ile paylasiliyor. -->
        <SolidColorBrush x:Key="CardBackground" Color="#D80D1219" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="Timer" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Ince doluluk cubugu; varsayilan ProgressBar sablonu kenarlik ve parlama getiriyor. -->
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="3" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Rectangle Fill="{TemplateBinding Background}" RadiusX="1.5" RadiusY="1.5" />
                            <Rectangle x:Name="PART_Track" />
                            <Rectangle x:Name="PART_Indicator"
                                       Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left"
                                       RadiusX="1.5"
                                       RadiusY="1.5" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,3" />
        </Style>

        <Style x:Key="SpellChip" TargetType="Border">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="SpellTemplate">
            <Border Style="{StaticResource SpellChip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ShortName}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{Binding Foreground}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Remaining}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="10"
                               Foreground="{Binding Foreground}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="PanelHost">
        <!-- Etkilesim modu cercevesi -->
        <Border x:Name="InteractiveBorder"
                Width="{Binding ActualWidth, ElementName=PanelHost}"
                Height="{Binding ActualHeight, ElementName=PanelHost}"
                BorderBrush="#FF5BD98A"
                BorderThickness="2"
                CornerRadius="4"
                Visibility="Collapsed" />

        <!-- Suruklenebilir paneller. Konumlari kod tarafinda Canvas.Left/Top ile veriliyor;
             Tag degeri ayar dosyasindaki panel kimligi. -->
        <Border Tag="status" Style="{StaticResource Card}"

                Visibility="{Binding Settings.ShowStatus, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF8B95A6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasGame}" Value="True">
                                    <Setter Property="Fill" Value="#FF5BD98A" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding StatusText}"
                           Foreground="{StaticResource PrimaryText}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding GameClock}"
                           Style="{StaticResource Timer}"
                           FontSize="13"
                           Foreground="{StaticResource MutedText}"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasGame, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>

        <Border Tag="warnings" Style="{StaticResource Card}"


                MaxWidth="380"
                BorderBrush="#66E8C15F"
                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="!"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFE8C15F"
                                       Margin="0,0,7,0" />
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       Foreground="{StaticResource PrimaryText}"
                                       TextWrapping="Wrap"
                                       MaxWidth="330" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ItemsControl Tag="objectives" ItemsSource="{Binding Objectives}">
            <ItemsControl.Visibility>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="HasGame" />
                    <Binding Path="Settings.ShowObjectives" />
                </MultiBinding>
            </ItemsControl.Visibility>
            <!-- Sayac sayisi maca gore degistigi icin sira tasabilir; sarmali yerlesim
                 kartlarin ekran disina cikmasini engelliyor. -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <!-- Sabit piksel yerine overlay genişliğinin yarısı: 720 tek bir ekrana göre
                         seçilmişti ve başka çözünürlüklerde ya sıkışıyor ya taşıyordu. -->
                    <WrapPanel Orientation="Horizontal"
                               MaxWidth="{Binding ActualWidth, ElementName=PanelHost,
                                                  Converter={StaticResource Fraction},
                                                  ConverterParameter=0.5}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Margin="0,0,8,0" Padding="0">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="3" Fill="{Binding Accent}" RadiusX="2" RadiusY="2" Margin="3" />
                            <StackPanel Margin="7,7,12,7">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryText}" />
                                <TextBlock Text="{Binding Remaining}"
                                           Style="{StaticResource Timer}"
                                           Foreground="{Binding StatusBrush}"
                                           FontWeight="{Binding RowWeight}"
                                           Margin="0,1,0,0" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Tag="build" Style="{StaticResource Card}" MinWidth="176">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="HasGame" />
                    <Binding Path="Settings.ShowBuild" />
                    <Binding Path="Build.HasTarget" />
                </MultiBinding>
            </Border.Visibility>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="{Binding Build.Icon}"
                           Width="18"
                           Height="18"
                           Margin="0,0,6,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Build.ItemName}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource PrimaryText}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                    <TextBlock Text="{Binding Build.Remaining}"
                               Style="{StaticResource Timer}"
                               Foreground="{Binding Build.Accent}" />
                    <TextBlock Text="altın"
                               Style="{StaticResource Caption}"
                               Margin="5,0,0,3"
                               VerticalAlignment="Bottom"
                               Visibility="{Binding Build.IsAffordable, Converter={StaticResource NotBoolToVis}}" />
                </StackPanel>
                <ProgressBar Style="{StaticResource Meter}"
                             Value="{Binding Build.Completion, Mode=OneWay}"
                             Foreground="{Binding Build.Accent}"
                             Margin="0,5,0,4" />
                <TextBlock Text="{Binding Build.Detail}" Style="{StaticResource Caption}" />
            </StackPanel>
        </Border>

        <Border Tag="lane" Style="{StaticResource Card}" MinWidth="176">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="HasGame" />
                    <Binding Path="Settings.ShowLane" />
                    <Binding Path="Lane.HasOpponent" />
                </MultiBinding>
            </Border.Visibility>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KORİDOR" Style="{StaticResource Caption}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Lane.Opponent}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource PrimaryText}"
                               Margin="8,0,0,0" />
                </StackPanel>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="CS" Style="{StaticResource Caption}" MinWidth="40" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding Lane.SelfCreepScore}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryText}"
                               MinWidth="34"
                               TextAlignment="Right" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{Binding Lane.OpponentCreepScore}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"
                               MinWidth="34"
                               TextAlignment="Right" />
                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="{Binding Lane.CreepScoreDifference}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding Lane.CreepScoreBrush}"
                               MinWidth="36"
                               TextAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Seviye" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{Binding Lane.SelfLevel}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Foreground="{StaticResource PrimaryText}"
                               TextAlignment="Right" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="{Binding Lane.OpponentLevel}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               Foreground="{StaticResource MutedText}"
                               TextAlignment="Right" />
                    <TextBlock Grid.Row="1" Grid.Column="3"
                               Text="{Binding Lane.LevelDifference}"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{Binding Lane.LevelBrush}"
                               TextAlignment="Right" />
                </Grid>

                <TextBlock Text="{Binding Lane.Detail}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Tag="enemies" Style="{StaticResource Card}"
                MinWidth="292">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="HasGame" />
                    <Binding Path="Settings.ShowEnemies" />
                </MultiBinding>
            </Border.Visibility>
            <StackPanel>
                <TextBlock Text="RAKİPLER" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,6" />
                <!-- Each row is its own Grid, so the spell and timer columns only line up across
                     rows if they share a sizing scope. -->
                <ItemsControl ItemsSource="{Binding Enemies}" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Ult" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SpellOne" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="SpellTwo" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Respawn" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Champion}"
                                               FontSize="12"
                                               Foreground="{StaticResource PrimaryText}" />
                                    <TextBlock Text="{Binding Kda}" Style="{StaticResource Caption}" FontSize="10" />
                                </StackPanel>

                                <!-- Ult rutbesi seviyeden kesin cikiyor: sayac degil, varlik
                                     bilgisi. Cooldown gostermek okunamayan runlerdeki haste'i
                                     tahmin etmeyi gerektirirdi. -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding UltLabel}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding UltBrush}"
                                           VerticalAlignment="Center"
                                           MinWidth="22"
                                           TextAlignment="Center"
                                           Margin="4,0" />

                                <ContentPresenter Grid.Column="2"
                                                  Content="{Binding SpellOne}"
                                                  ContentTemplate="{StaticResource SpellTemplate}" />
                                <ContentPresenter Grid.Column="3"
                                                  Content="{Binding SpellTwo}"
                                                  ContentTemplate="{StaticResource SpellTemplate}" />

                                <TextBlock Grid.Column="4"
                                           Text="{Binding Remaining}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush}"
                                           MinWidth="46"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Tag="enemyItems" Style="{StaticResource Card}" MinWidth="292">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="HasGame" />
                    <Binding Path="Settings.ShowEnemyItems" />
                    <Binding Path="HasEnemyItems" />
                </MultiBinding>
            </Border.Visibility>
            <StackPanel>
                <TextBlock Text="RAKİP EŞYA" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,5" />
                <ItemsControl ItemsSource="{Binding EnemyItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,1">
                                <TextBlock Text="{Binding Clock}"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedText}" />
                                <TextBlock Text="{Binding Champion}"
                                           FontSize="11"
                                           Foreground="{Binding Foreground}"
                                           Margin="8,0,0,0" />
                                <TextBlock Text="→"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedText}"
                                           Margin="5,0" />
                                <!-- Ikon gelmezse Image bos kalir ve satir yalnizca daralir;
                                     eksik gorsel hicbir zaman metni gizlemez. -->
                                <Image Source="{Binding Icon}"
                                       Width="16"
                                       Height="16"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="{Binding ItemName}"
                                           FontSize="11"
                                           Foreground="{Binding Foreground}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Tag="feed" Style="{StaticResource Card}"



                MinWidth="210">
            <Border.Visibility>
                <MultiBinding Converter="{StaticResource AllTrue}">
                    <Binding Path="HasGame" />
                    <Binding Path="Settings.ShowFeed" />
                </MultiBinding>
            </Border.Visibility>
            <StackPanel>
                <TextBlock Text="OLAYLAR" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,5" />
                <ItemsControl ItemsSource="{Binding Feed}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedText}"
                                       Margin="2,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Ayar karti: yalnizca etkilesim modunda (Ctrl+Alt+O) gorunur ve tiklanabilir -->

        <!-- Kayitli maclar. Sampiyon secimi gibi bu da oyun arasinda okunur; oyun icindeyken
             gorunmesinin bir zarari yok ama asil yeri lobide. -->

        <!-- Sabit: gecici bir kart, konumlandirilacak bir sey degil. Canvas.Right/Bottom ile
             sag alta yasliyor. -->
        <Border Style="{StaticResource Card}"
                Canvas.Right="24"
                Canvas.Bottom="28"
                MaxHeight="560"
                Visibility="{Binding IsInteractive, Converter={StaticResource BoolToVis}}">
            <!-- Kart her yeni secici ile uzuyor ve ustteki panellerin uzerine biniyordu. Yukseklik
                 sinirli ve icerik kayiyor; etkilesim modunda fare zaten calisiyor. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Iki sutun: tek sutunda kart o kadar uzuyor ki ustteki panellerin uzerine
                     biniyor ve tam da degistirdigin seyi gizliyordu. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" MinWidth="118">
                        <TextBlock Text="PANELLER" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,4" />
                        <CheckBox Content="Durum" IsChecked="{Binding Settings.ShowStatus}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Objektifler" IsChecked="{Binding Settings.ShowObjectives}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Rakipler" IsChecked="{Binding Settings.ShowEnemies}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Olaylar" IsChecked="{Binding Settings.ShowFeed}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Hedef eşya" IsChecked="{Binding Settings.ShowBuild}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Rakip eşya" IsChecked="{Binding Settings.ShowEnemyItems}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Koridor" IsChecked="{Binding Settings.ShowLane}" Style="{StaticResource Toggle}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" MinWidth="118" Margin="18,0,0,0">
                        <TextBlock Text="SAYAÇLAR" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,0,0,4" />
                        <CheckBox Content="Dragon" IsChecked="{Binding Settings.ShowDragon}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Herald" IsChecked="{Binding Settings.ShowHerald}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Baron" IsChecked="{Binding Settings.ShowBaron}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Elder" IsChecked="{Binding Settings.ShowElder}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Void grub" IsChecked="{Binding Settings.ShowVoidgrubs}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Buff süreleri" IsChecked="{Binding Settings.ShowBuffs}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Inhibitor" IsChecked="{Binding Settings.ShowInhibitors}" Style="{StaticResource Toggle}" />
                        <CheckBox Content="Dalga" IsChecked="{Binding Settings.ShowWave}" Style="{StaticResource Toggle}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="HEDEF EŞYA"
                           Style="{StaticResource Caption}"
                           FontWeight="SemiBold"
                           Margin="2,10,0,2"
                           Visibility="{Binding Settings.ShowBuild, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding BuildCandidates}"
                              Visibility="{Binding Settings.ShowBuild, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PickerButton}"
                                    Content="{Binding Name}"
                                    Foreground="{Binding Foreground}"
                                    Click="OnBuildTargetClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="KORİDOR RAKİBİ"
                           Style="{StaticResource Caption}"
                           FontWeight="SemiBold"
                           Margin="2,10,0,2"
                           Visibility="{Binding Settings.ShowLane, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding LaneCandidates}"
                              Visibility="{Binding Settings.ShowLane, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PickerButton}"
                                    Content="{Binding Name}"
                                    Foreground="{Binding Foreground}"
                                    Click="OnLaneOpponentClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="KISAYOLLAR" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,10,0,2" />
                <ItemsControl ItemsSource="{Binding Hotkeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource PickerButton}"
                                    Content="{Binding Text}"
                                    Foreground="{Binding Foreground}"
                                    Click="OnHotkeyClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource PickerButton}"
                        Content="Kısayolları sıfırla"
                        Foreground="{StaticResource PrimaryText}"
                        Click="OnResetHotkeysClick" />

                <TextBlock Text="YERLEŞİM" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,10,0,2" />
                <TextBlock Text="Panelleri sürükleyerek taşı"
                           Style="{StaticResource Caption}"
                           FontSize="10"
                           Margin="2,0,0,2" />
                <Button Style="{StaticResource PickerButton}"
                        Content="Konumları sıfırla"
                        Foreground="{StaticResource PrimaryText}"
                        Click="OnResetPlacementsClick" />

                <TextBlock Text="OPAKLIK" Style="{StaticResource Caption}" FontWeight="SemiBold" Margin="2,10,0,2" />
                <Slider Minimum="0.3"
                        Maximum="1"
                        Value="{Binding Settings.Opacity}"
                        TickFrequency="0.05"
                        IsSnapToTickEnabled="True"
                        Margin="2,0" />
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Canvas>
</Window>
