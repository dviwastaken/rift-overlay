<Window x:Class="RiftOverlay.Client.ClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RiftOverlay.ViewModels"
        Title="RiftOverlay"
        Width="940"
        Height="640"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B1017"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI">

    <!--
        Overlay'in tam tersi bir pencere: kenarlikli, boyutlandirilabilir, gorev cubugunda gorunur,
        odagi seve seve alir. WS_EX_TRANSPARENT / NOACTIVATE dunyasiyla hicbir ilgisi yok.
    -->

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:NotBoolConverter x:Key="NotBool" />

        <SolidColorBrush x:Key="Surface" Color="#FF121A23" />
        <SolidColorBrush x:Key="SurfaceAlt" Color="#FF0E151C" />
        <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="HairlineStrong" Color="#3AFFFFFF" />
        <SolidColorBrush x:Key="Elevated" Color="#FF17212C" />
        <SolidColorBrush x:Key="FieldBackground" Color="#FF0A1018" />
        <SolidColorBrush x:Key="AccentSoft" Color="#26F2C14E" />

        <!--
            Buradan asagisi WPF'in varsayilan denetim govdelerini degistiriyor. Sebep kozmetikten
            fazlasi: stillenmemis bir Button, ComboBox ve kaydirma cubugu pencerenin geri kalani ne
            kadar duzenli olursa olsun Windows XP donemi gibi duruyor, cunku sistem temasindan
            geliyorlar ve bu pencerenin paletiyle hicbir iliskileri yok.
        -->

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBackground}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Grid>
                                <!-- Yer tutucu metni Tag'den geliyor. WPF'in hazir bir yer tutucusu
                                     yok ve bunun icin ayri bir donusturucu yazmak, kutunun kendi
                                     sablonunda halledilebilen bir seyi disari tasimak olurdu. -->
                                <TextBlock x:Name="Hint"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource MutedText}"
                                           FontSize="13"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />

                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Elevated}" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource SurfaceAlt}" />
                            </Trigger>
                            <!-- Devre disi bir dugme sonucu degistirmeyecegini soylemeli; ayni
                                 renkte durup tiklamayi yutmasi hatali gorunur. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#FF10161E" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Accent}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFF7D07A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFD9A93C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboChrome" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                CornerRadius="7">
                            <Path Data="M 0 0 L 4.5 4.5 L 9 0"
                                  Stroke="{StaticResource MutedText}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource HairlineStrong}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Style="{StaticResource ComboChrome}"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}" />

                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False" />

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{StaticResource Elevated}"
                                        BorderBrush="{StaticResource HairlineStrong}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,4,0,0"
                                        Padding="0,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ItemsPresenter />
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="5"
                                Margin="4,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Chrome"
                                Background="#2BFFFFFF"
                                CornerRadius="3"
                                Margin="3,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <!-- Ok dugmeleri yok. Yer kaplayan, kimsenin kullanmadigi ve sistem
                             temasindan gelen tek parca onlardi. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Kart govdesi. Tek yerde tanimli, cunku daha once her panel kendi kenar yaricapini ve
             cizgisini tasiyordu ve birini degistirmek digerlerini geride birakiyordu. -->
        <!--
            Oran rengi sampiyonun kendi oranina gore, %50'ye gore degil. %50 oyun hakkinda bir
            gercek, bu sampiyon hakkinda degil: %47'lik bir sampiyonun her satiri kirmizi olurdu ve
            hangisinin yapilacagi konusunda hicbir sey soylemezdi. Bayrak bos oldugunda renk de yok,
            cunku ince bir orneklemi yesile boyamak gurultu hakkinda hukum vermektir.
        -->
        <!-- Kisisel istatistikte esik %50: bu senin kendi kaydin, bir sampiyonun herkes
             uzerindeki ortalamasi degil. Az macli satir renklenmiyor. -->
        <Style x:Key="EvenRateText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AboveEven}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AboveEven}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RateText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AboveBaseline}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Positive}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AboveBaseline}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Negative}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
        </Style>

        <!--
            Iki takim icin tek sablon. Onceden ayni satir iki kez yazilmisti ve birini duzeltmek
            digerini geride birakiyordu; portreyi iki yere birden eklemek ayni tuzagi tazelerdi.
        -->
        <DataTemplate x:Key="PickRow">
            <Border Style="{StaticResource Card}" Padding="8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Portre gelmemisse yerinde bos bir kare duruyor: satirin yuksekligi
                         resim indi diye zipplamasin. -->
                    <Border Grid.Column="0"
                            Width="38"
                            Height="38"
                            CornerRadius="7"
                            Background="{StaticResource FieldBackground}"
                            Margin="0,0,11,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                        <Setter Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Image Source="{Binding Portrait}"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Champion}" FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                    <Style.Triggers>
                                        <!-- Kendi secimin vurgulu: on kisilik iki listede kendini
                                             aramak zorunda kalmayasin. -->
                                        <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding Position}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,1,0,0" />
                    </StackPanel>

                    <!-- Kilitli ile seciliyor ayri renkte. Seciliyor olan hala degisebilir ve
                         ikisini ayni gostermek, kimsenin oynamadigi bir sampiyona karsi plan
                         yapmanin yoludur. -->
                    <Border Grid.Column="2"
                            CornerRadius="4"
                            Padding="7,3"
                            VerticalAlignment="Center"
                            Margin="8,0,2,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
                                    </DataTrigger>
                                    <!-- Bos koltuk: durum metni yoksa rozet de yok. Zemini
                                         birakmak, hicbir sey yazmayan bir altin cizgi biraktiriyor. -->
                                    <DataTrigger Binding="{Binding State}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding State}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLocked}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Border>

                            <!-- Secili bolumu renk tonu degil bir isaret soylemeli: iki koyu ton
                                 arasindaki fark ekran parlakligina gore kayboluyor. -->
                            <Border x:Name="Bar"
                                    Width="3"
                                    Height="18"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    CornerRadius="2"
                                    Background="{StaticResource Accent}"
                                    Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1AFFFFFF" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <!-- Bolum ici basliklar. Buyuk harf ve sonmus renk, baslikla icerigi ayirmak icin bir
             cizgiye ihtiyac birakmiyor. -->
        <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>

        <Style x:Key="Placeholder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: gezinme -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,16,12,12">

                <StackPanel DockPanel.Dock="Top" Margin="4,0,0,18">
                    <TextBlock Text="RiftOverlay"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionText"
                               Text="İstemci aranıyor…"
                               Style="{StaticResource Caption}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Overlay tray ikonundan yönetilir"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="4,0,0,0" />
                </StackPanel>

                <StackPanel VerticalAlignment="Top">
                    <RadioButton x:Name="NavChampSelect"
                                 Content="Şampiyon seçimi"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 IsChecked="True"
                                 Checked="OnNavChanged" />
                    <RadioButton x:Name="NavPlayer"
                                 Content="Oyuncu"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Checked="OnNavChanged" />
                    <RadioButton x:Name="NavBuild"
                                 Content="Build"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Checked="OnNavChanged" />
                    <RadioButton x:Name="NavStats"
                                 Content="İstatistikler"
                                 Style="{StaticResource NavItem}"
                                 GroupName="Nav"
                                 Checked="OnNavChanged" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sag: icerik -->
        <!-- Yatay kaydirma acikca kapali. Varsayilani kapali degil, ve acik oldugunda icerik
             sonsuz genislikte olculuyor: yuva kartlari gibi genis bir cocuk butun paneli disari
             itiyor, satirlar sagdan tasiyor ve kimse yatay cubugu gormedigi icin sebebi
             gorunmuyor. -->
        <ScrollViewer x:Name="ContentScroll"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="28,24">
            <Grid>

                <StackPanel x:Name="ChampSelectPane" Visibility="Collapsed">
                    <TextBlock Text="Şampiyon Seçimi" Style="{StaticResource SectionTitle}" />

                    <!-- Sayac kucuk bir yan not degil, ekrandaki en zamana duyarli sey. -->
                    <Grid Margin="0,0,0,18">
                        <TextBlock Text="{Binding Status}"
                                   Style="{StaticResource Caption}"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />

                        <Border Style="{StaticResource Card}"
                                Background="{StaticResource SurfaceAlt}"
                                Padding="14,5"
                                HorizontalAlignment="Right"
                                Visibility="{Binding InChampSelect, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Clock}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}" />
                        </Border>
                    </Grid>

                    <Grid Visibility="{Binding InChampSelect, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="TAKIMIN" Style="{StaticResource GroupHeader}" />
                                <ItemsControl ItemsSource="{Binding Allies}" ItemTemplate="{StaticResource PickRow}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="RAKİPLER" Style="{StaticResource GroupHeader}" />
                                <ItemsControl ItemsSource="{Binding Enemies}" ItemTemplate="{StaticResource PickRow}" />
                            </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Margin="2,12,0,0"
                                Visibility="{Binding HasBans, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="RAKİP YASAKLARI" Style="{StaticResource Caption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Bans}" Style="{StaticResource Caption}" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PlayerPane" Visibility="Collapsed">
                    <TextBlock Text="Oyuncu" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Riot ID ile ara: isim#etiket"
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="isim#etiket"
                                 Width="250"
                                 KeyDown="OnPlayerKeyDown" />

                        <Button Content="Ara"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnSearchPlayer"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Headline}"
                               Foreground="{StaticResource PrimaryText}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,0,10" />

                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Ranks}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="14,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Queue}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Tier}" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Record}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="SON MAÇLAR"
                               Style="{StaticResource GroupHeader}"
                               Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Matches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="12,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Kazandi/kaybetti bir serit olarak. Tek harf, satirin en
                                             solunda ve digerleriyle ayni agirlikta, listeyi taramaya
                                             calisirken en zor okunan parcaydi. -->
                                        <Border Grid.Column="0"
                                                Width="3"
                                                CornerRadius="2"
                                                HorizontalAlignment="Left"
                                                Margin="0,1,0,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Negative}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Won}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource Positive}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Background="{StaticResource FieldBackground}"
                                                    Margin="0,0,10,0">
                                                <Image Source="{Binding Portrait}"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Border>

                                            <TextBlock Text="{Binding Champion}"
                                                       Foreground="{StaticResource PrimaryText}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Score}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource PrimaryText}" MinWidth="66" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding CreepScore}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" MinWidth="62" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" MinWidth="48" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding Mode}" Style="{StaticResource Caption}" MinWidth="52" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="{Binding When}" Style="{StaticResource Caption}" MinWidth="76" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="BuildPane" Visibility="Collapsed">
                    <TextBlock Text="Build" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="OP.GG'den şampiyon ve koridora göre öneri."
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <!-- Satir ici renk ve dolgu yok: hepsi pencere stillerinden geliyor,
                             yoksa tek bir kutu digerlerinden ayri kalir. -->
                        <TextBox x:Name="ChampionBox"
                                 Text="{Binding Champion, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Şampiyon adı"
                                 Width="210"
                                 KeyDown="OnChampionKeyDown" />

                        <ComboBox x:Name="PositionBox"
                                  ItemsSource="{Binding Positions}"
                                  SelectedItem="{Binding Position}"
                                  Width="118"
                                  Margin="8,0,0,0" />

                        <Button Content="Getir"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnFetchBuild"
                                Margin="8,0,0,0"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14" />

                    <!-- Koridora ozgu rakamlar. Ortalama her koridoru harmanliyor, iki koridorda da
                         oynanan bir sampiyonda hicbirine ait olmayan bir oran cikiyor. Konum blogu
                         yoksa serit hic gorunmuyor: eksik verinin yerine baska bir sorunun cevabini
                         koymak yok. -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,14"
                                Visibility="{Binding HasBuild, Converter={StaticResource BoolToVis}}">
                        <Border Background="{StaticResource SurfaceAlt}"
                                BorderBrush="{StaticResource Accent}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,4"
                                Margin="0,0,8,0"
                                Visibility="{Binding HasTier, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TierLabel}"
                                       Foreground="{StaticResource Accent}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </Border>

                        <Border Background="{StaticResource SurfaceAlt}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,4"
                                Margin="0,0,8,0">
                            <TextBlock Text="{Binding PositionRate}"
                                       Foreground="{StaticResource PrimaryText}"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="12" />
                        </Border>

                        <Border Background="{StaticResource SurfaceAlt}"
                                BorderBrush="{StaticResource Hairline}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,4">
                            <TextBlock Text="{Binding DamageLabel}"
                                       Foreground="{StaticResource AccentAlt}"
                                       FontSize="12" />
                        </Border>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Lines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="14,10"
                                        Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Label}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalAlignment="Center" />

                                        <ItemsControl Grid.Column="1"
                                                      ItemsSource="{Binding Icons}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Image Source="{Binding}"
                                                           Width="22"
                                                           Height="22"
                                                           Margin="0,0,3,0"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Value}"
                                                   Foreground="{StaticResource PrimaryText}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Rate}"
                                                   Style="{StaticResource RateText}"
                                                   FontSize="12"
                                                   Margin="14,0,0,0" />

                                        <!-- Ornek sayisi her satirda: 6 maclik bir build'i rakamsiz
                                             gostermek gurultuyu tavsiye diye sunmaktir. Ince
                                             ornekler ayrica isaretleniyor. -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding Sample}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11"
                                                   MinWidth="86"
                                                   TextAlignment="Right"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThin}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Yetenek dizilimi. Seviye numarasi hucrenin uzerinde tasiniyor, siranin
                         indisinden turetilmiyor: OP.GG on bes adim donduruyor, bir sampiyon on
                         sekiz kez seviye atliyor. Indisle numaralamak burada dogru olur ve sunucu
                         tam sirayi dondurmeye baslarsa sessizce yanlis olurdu. -->
                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasSkillOrder, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="YETENEK SIRASI"
                                   Style="{StaticResource GroupHeader}" />

                        <ItemsControl ItemsSource="{Binding SkillOrder}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,4,0" Width="26">
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{StaticResource MutedText}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="9"
                                                   TextAlignment="Center"
                                                   Margin="0,0,0,2" />
                                        <Border CornerRadius="4"
                                                Height="26"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Surface}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUltimate}" Value="True">
                                                            <Setter Property="Background" Value="#33F2C14E" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Ability}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUltimate}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Yuva bazli secenekler. Orneklem her yuvada duserek geliyor; alti maca
                         dayanan bir "en iyi altinci esya" rakamsiz gosterilirse gurultu tavsiye
                         gibi okunur, o yuzden sayi her secenegin yaninda ve incesi isaretli. -->
                    <StackPanel Margin="0,18,0,0"
                                Visibility="{Binding HasSlots, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SONRAKİ EŞYA SEÇENEKLERİ"
                                   Style="{StaticResource GroupHeader}" />

                        <TextBlock Text="{Binding BaselineNote}"
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="2,0,0,10" />

                        <ItemsControl ItemsSource="{Binding Slots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}"
                                            Padding="12,10"
                                            Margin="0,0,6,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}"
                                                       Style="{StaticResource Caption}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />

                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <ItemsControl Grid.Column="0"
                                                                          Grid.RowSpan="2"
                                                                          ItemsSource="{Binding Icons}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,8,0">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Image Source="{Binding}"
                                                                               Width="28"
                                                                               Height="28"
                                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- TextTrimming tek basina yetmiyor: genisligi
                                                                 sinirlanmamis bir TextBlock kirpilmak yerine
                                                                 istedigi kadar yer istiyor ve karti buyutuyor. -->
                                                            <TextBlock Grid.Column="1"
                                                                       Grid.Row="0"
                                                                       Text="{Binding Name}"
                                                                       Foreground="{StaticResource PrimaryText}"
                                                                       FontSize="12"
                                                                       MaxWidth="150"
                                                                       HorizontalAlignment="Left"
                                                                       TextTrimming="CharacterEllipsis" />

                                                            <StackPanel Grid.Column="1"
                                                                        Grid.Row="1"
                                                                        Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Rate}"
                                                                           Style="{StaticResource RateText}"
                                                                           FontSize="11" />
                                                                <TextBlock Text="{Binding Sample}"
                                                                           FontFamily="Cascadia Mono, Consolas"
                                                                           FontSize="11"
                                                                           Margin="8,0,0,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsThin}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>


                    <!-- Iki listede de gosterilen oran DAIMA bu sampiyonun kendi orani. Sunucu
                         weak_counters icinde duz win_rate'i karsi tarafa ait veriyor; my_win_rate
                         ikisinde de ayni tarafi gosterdigi icin o kullaniliyor. -->

                    <TextBlock Text="İYİ GİTTİĞİ EŞLEŞMELER"
                               Style="{StaticResource Caption}"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"
                               Visibility="{Binding HasStrong, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding StrongAgainst}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="12,7"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Champion}" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Rate}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource Positive}" MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Sample}" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinWidth="80" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThin}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ZORLANDIĞI EŞLEŞMELER"
                               Style="{StaticResource Caption}"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"
                               Visibility="{Binding HasWeak, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding WeakAgainst}" Margin="0,0,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="12,7"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Champion}" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Rate}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource Negative}" MinWidth="46" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Sample}" FontFamily="Cascadia Mono, Consolas" FontSize="11" MinWidth="80" TextAlignment="Right" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsThin}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding CountersNote}"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="2,0,0,10" />
                    <StackPanel Visibility="{Binding HasBuild, Converter={StaticResource BoolToVis}}"
                                Margin="0,14,0,0">

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding CanApplyRunes, Converter={StaticResource BoolToVis}}">
                            <Button Content="Rünleri uygula"
                                    Click="OnApplyRunes"
                                    Padding="16,6"
                                    FontSize="13"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />

                            <!-- Ne yazilacagi dugmenin yaninda: uygulamak bir run sayfasini silip
                                 yeniden kuruyor ve geri alma yok. -->
                            <TextBlock Text="{Binding RuneSummary}"
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,8,0,0"
                                    Visibility="{Binding CanApplyItems, Converter={StaticResource BoolToVis}}">
                            <Button Content="Eşya setini yaz"
                                    Click="OnApplyItems"
                                    Padding="16,6"
                                    FontSize="13"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />

                            <TextBlock Text="Mevcut setlerin korunur; yalnızca bu şampiyon için yazdığımız set değişir."
                                       Style="{StaticResource Caption}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Text="Vurgulanan örneklem sayıları eşiğin altında — o satır tavsiye değil, gözlem. Yazarken yalnızca &quot;RiftOverlay&quot; adlı rün sayfaları ve eşya setleri değiştiriliyor; kendi sayfalarına ve başka araçların setlerine dokunulmuyor." />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="StatsPane" Visibility="Collapsed">
                    <TextBlock Text="İstatistikler" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Bu araç tarafından kaydedilen kendi maçlarından."
                               Style="{StaticResource Caption}"
                               Margin="0,0,0,16" />

                    <TextBlock Text="{Binding Status}"
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />

                    <ItemsControl ItemsSource="{Binding Headlines}" Margin="0,0,0,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="14,12"
                                        Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBlock Text="{Binding Value}"
                                                   Foreground="{StaticResource PrimaryText}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,2" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Style="{StaticResource Caption}"
                                                   FontSize="10"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="ŞAMPİYONLAR"
                               Style="{StaticResource Caption}"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"
                               Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Champions}" Margin="0,0,0,16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="12,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Champion}" Foreground="{StaticResource PrimaryText}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Played}" Style="{StaticResource Caption}" MinWidth="64" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding WinRate}" Style="{StaticResource EvenRateText}" FontSize="12" MinWidth="48" TextAlignment="Right" Margin="10,0,0,0" />
                                        <TextBlock Grid.Column="3" Text="{Binding Kda}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" MinWidth="94" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding CreepScoreAtTen}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" MinWidth="44" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="10. dakikadaki CS" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="MAÇLAR"
                               Style="{StaticResource Caption}"
                               FontWeight="SemiBold"
                               Margin="2,0,0,6"
                               Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Matches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}"
                                        Padding="12,8"
                                        Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Result}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Won}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Positive}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Result}" Value="M">
                                                            <Setter Property="Foreground" Value="{StaticResource Negative}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="{Binding Champion}" Foreground="{StaticResource PrimaryText}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Record}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{StaticResource PrimaryText}" MinWidth="66" TextAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding CreepScore}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" MinWidth="62" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource Caption}" FontFamily="Cascadia Mono, Consolas" MinWidth="48" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding When}" Style="{StaticResource Caption}" MinWidth="76" TextAlignment="Right" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
